{
  "expo": {
    "name": "e-Drive",
    "slug": "e-drive",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "edrive",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.edrive.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Rota planlamak ve yakınındaki şarj istasyonlarını göstermek için konumun kullanılır.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.edrive.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B1220",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"],
      "predictiveBackGestureEnabled": false
    },
    "web": { "favicon": "./assets/favicon.png" },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Rota planlamak ve yakınındaki şarj istasyonlarını göstermek için konumun kullanılır."
        }
      ]
    ]
  }
}
